# ==========================================
# MSFinanças - Backend Environment Variables
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=msfinancas
POSTGRES_PORT=5432

# Database URL
# Local Docker Compose: postgresql://postgres:postgres@postgres:5432/msfinancas
# Local Native/Host: postgresql://postgres:postgres@localhost:5432/msfinancas
# Render: Render will automatically supply DATABASE_URL from your PostgreSQL service
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/msfinancas

# Security & Tokens
SECRET_KEY=
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server & Routing
PORT=8001
API_V1_STR=/api/v1
ENVIRONMENT=development

# CORS Origins (comma-separated or JSON list)
# For Render: add your frontend Render URL, e.g.:
# CORS_ORIGINS=https://msfinancas-front.onrender.com,http://localhost:5173,http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000

# Recuperação de senha: TLS obrigatório (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_URL=
